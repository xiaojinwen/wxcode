<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Xposed module metadata -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 启动前台 Service 必需（Android 9+），否则 startForegroundService 抛 SecurityException，前台Service起不来导致灭屏Doze限流 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14+ 对 dataSync 类型前台Service要求该权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    
    <application
        android:label="wxcode"
        android:allowBackup="true"
        android:supportsRtl="true">
        
        <!-- Xposed模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true"/>
        <meta-data
            android:name="xposeddescription"
            android:value="微信小程序登录Hook模块(支持分身)"/>
        <meta-data
            android:name="xposedminversion"
            android:value="82"/>
        <!-- LSPosed支持多作用域，使用逗号分隔或留空让用户手动选择 -->
        <meta-data
            android:name="xposedscope"
            android:value="com.tencent.mm"/>
        <!-- 系统分身与主应用包名相同，勾选 com.tencent.mm 即可覆盖所有实例 -->

        <!-- 前台保活 Service：把微信进程优先级提升到前台，解决后台接口请求被限流卡住的问题 -->
        <service
            android:name=".hook.WxLoginHook$KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>